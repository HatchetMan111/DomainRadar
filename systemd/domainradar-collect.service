[Unit]
Description=DomainRadar – Certificate-Transparency-Logs lesen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=domainradar
Group=domainradar
WorkingDirectory=/opt/domainradar
EnvironmentFile=/opt/domainradar/.env
ExecStart=/opt/domainradar/venv/bin/python -m domainradar.collector
Nice=10