[Unit]
Description=DomainRadar – Web-API und Oberfläche
Documentation=https://github.com/HatchetMan111/DomainRadar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=domainradar
Group=domainradar
WorkingDirectory=/opt/domainradar
EnvironmentFile=/opt/domainradar/.env
# Port und Host aus der .env – api.py liest DOMAINRADAR_PORT/DOMAINRADAR_HOST
# selbst, deshalb steht hier kein --port (systemd expandiert keine Variablen
# in ExecStart).
ExecStart=/opt/domainradar/venv/bin/python -m domainradar.api
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Härtung: die App liest nur ihre eigene Datenbank und schreibt ins Log.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/domainradar/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target