# DomainRadar – Umgebungsvariablen (Vorlage)
# Kopiere diese Datei zu .env und passe die Werte an:
#   cp .env.example .env && chmod 600 .env
#
# WICHTIG: Werte, die in der Web-Oberfläche (Einstellungen) gespeichert
# wurden, überschreiben die Werte aus dieser Datei.

# ── Datenbank & API ──────────────────────────────────────────────────────────
DOMAINRADAR_DB=/opt/domainradar/data/domainradar.db
DOMAINRADAR_PORT=8477
DOMAINRADAR_HOST=0.0.0.0
# Auf 127.0.0.1 setzen, wenn nur lokal erreichbar (empfohlen ohne Auth):
# DOMAINRADAR_HOST=127.0.0.1
DOMAINRADAR_WEB=/opt/domainradar/web/dist

# ── LLM-Kaskade ──────────────────────────────────────────────────────────────
# Reihenfolge der Provider, Komma-getrennt. Leer = nur deterministisch.
LLM_CHAIN=ollama,openrouter
# Unter dieser Konfidenz (0-1) wird an den nächsten Provider eskaliert:
# LLM_ESCALATE_BELOW=0.75

# Stufe 1: Ollama (lokal, gratis)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Stufe 2: OpenRouter (kostenpflichtig, braucht API-Key)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_API_KEY=

# ── Erfassung ────────────────────────────────────────────────────────────────
# 0 = unbegrenzt (nur für Tests sinnvoll begrenzen):
# DOMAINRADAR_COLLECT_MAX=0
DOMAINRADAR_ENRICH_BATCH=100
DOMAINRADAR_ENRICH_TIMEOUT=10
DOMAINRADAR_RESPECT_ROBOTS=1
DOMAINRADAR_CLASSIFY_BATCH=10
DOMAINRADAR_CHANGES_LIMIT=300

# ── Auswertung ───────────────────────────────────────────────────────────────
TARGET_CATEGORIES=software,energy,smart-home,climate

# ── Sicherheit (optional) ────────────────────────────────────────────────────
# Wenn gesetzt, müssen API-Requests einen Header senden:
#   Authorization: Bearer <token>
# Leer = keine Authentifizierung (nur im LAN betreiben!):
# DOMAINRADAR_API_TOKEN=
